# Resend API Key
# Get this from https://resend.com/api-keys after signing up and verifying your domain
RESEND_API_KEY=re_your_api_key_here

# Google Analytics 4 Measurement ID
# To enable GA4 tracking:
# 1. Create a Google Analytics 4 property at https://analytics.google.com
# 2. Get your Measurement ID (format: G-XXXXXXXXXX)
# 3. Replace 'GA4_MEASUREMENT_ID' in index.html with your actual ID
# Note: This is not a Vite environment variable - it's directly embedded in index.html
# Example: gtag('config', 'G-ABC123XYZ');

